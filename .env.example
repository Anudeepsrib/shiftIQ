# ShiftIQ local development environment
# Copy to .env for local use. Do not commit .env.

# Optional config file path
# MIGRATION_CONFIG_FILE=config/defaults.yaml

# API authentication
# Use a unique random value for local testing. Production rejects demo/default keys.
MIGRATION_API_KEY=

# Server
MIGRATION_SERVER__ENVIRONMENT=development
MIGRATION_SERVER__HOST=127.0.0.1
MIGRATION_SERVER__PORT=8000
MIGRATION_SERVER__CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MIGRATION_SERVER__DOCS_ENABLED=true

# Security and local filesystem boundaries
MIGRATION_SECURITY__LEVEL=high
MIGRATION_SECURITY__AUDIT_LOGGING=true
MIGRATION_SECURITY__MAX_FILE_SIZE_KB=5000
MIGRATION_SECURITY__RATE_LIMIT_PER_MINUTE=60
MIGRATION_SECURITY__ALLOWED_ROOTS=["."]
MIGRATION_SECURITY__MAX_FILES=5000
MIGRATION_SECURITY__EXPOSE_RAW_FINDINGS=false

# Analysis
MIGRATION_ANALYSIS__MAX_WORKERS=4
MIGRATION_ANALYSIS__TIMEOUT_SECONDS=300
MIGRATION_ANALYSIS__COST_RATE_PER_HOUR=100.0

# Observability
MIGRATION_OBSERVABILITY__LOG_LEVEL=INFO
MIGRATION_OBSERVABILITY__LOG_FORMAT=text

# Optional LangSmith Fleet integration (local behavior does not require these)
SHIFTIQ_FLEET_ENABLED=false
SHIFTIQ_LANGSMITH_TRACING=false
SHIFTIQ_REMOTE_MCP_ENABLED=false
SHIFTIQ_REMOTE_MCP_HOST=127.0.0.1
SHIFTIQ_REMOTE_MCP_PORT=8001
SHIFTIQ_REMOTE_MCP_PATH=/mcp
SHIFTIQ_REMOTE_MCP_AUTH_ENABLED=true
SHIFTIQ_MCP_API_KEY=
SHIFTIQ_WORKSPACE_ROOT=.shiftiq-workspaces
SHIFTIQ_WORKSPACE_TTL_SECONDS=86400
SHIFTIQ_WORKSPACE_MAX_MB=512
SHIFTIQ_WORKSPACE_MAX_COUNT=100
SHIFTIQ_REQUEST_TIMEOUT_SECONDS=300
SHIFTIQ_REMOTE_RATE_LIMIT_PER_MINUTE=60
SHIFTIQ_STATIC_VERIFICATION=true
SHIFTIQ_EXECUTION_VERIFICATION=false

# Optional protected GitHub credential for private repository ingestion.
# Do not pass this token in prompts or MCP tool arguments.
SHIFTIQ_GITHUB_TOKEN=
SHIFTIQ_GITHUB_CLONE_TIMEOUT_SECONDS=180

# Optional LangSmith tracing / programmatic Fleet invocation
LANGSMITH_API_KEY=
LANGGRAPH_API_KEY=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_PROJECT=shiftiq
LANGSMITH_FLEET_AGENT_ID=
LANGSMITH_FLEET_API_URL=
